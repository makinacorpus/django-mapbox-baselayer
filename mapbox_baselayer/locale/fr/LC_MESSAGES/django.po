msgid "Style URL is required for Mapbox Style layers."
msgstr ""

msgid "Style options"
msgstr "Options de style"

msgid "Advanced options"
msgstr "Options avancées"

msgid "Map Utils"
msgstr "Utilitaires de carte"

msgid "Style URL"
msgstr "URL de style"

msgid "Raster tiles"
msgstr "Tuiles raster"

#, python-format
msgid "MapBaseLayer %(pk)s does not exist"
msgstr "La couche de base %(pk)s n'existe pas"

#, python-format
msgid "Baselayer min zoom has been selected: %(min_zoom)s"
msgstr "Le zoom minimum de la couche de base a été sélectionné : %(min_zoom)s"

#, python-format
msgid "Baselayer max zoom has been selected: %(max_zoom)s "
msgstr "Le zoom maximum de la couche de base a été sélectionné : %(max_zoom)s"

msgid "Name"
msgstr "Nom"

msgid "Is overlay"
msgstr "Est une sur-couche"

msgid "Whether this layer is an overlay (displayed on top of base layers) or a base layer."
msgstr "Définit si cette couche est une sur-couche (affichée au-dessus des fonds de plan) ou un fond de plan."

msgid "Order"
msgstr "Ordre"

msgid "Order of the layer in the list. Lower numbers are displayed first."
msgstr "Ordre de la couche dans la liste. Les nombres plus petits sont affichés en premier."

msgid "Layer type"
msgstr "Type de couche"

msgid "Should start by http(s):// or mapbox://"
msgstr "Doit commencer par http(s):// ou mapbox://"

msgid "Override default sprite URL."
msgstr "Surcharger l'URL de sprite par défaut."

msgid "Sprite URL"
msgstr "URL du sprite"

msgid "Override default glyphs URL."
msgstr "Surcharger l'URL de glyphs par défaut."

msgid "Glyphs URL"
msgstr "URL des glyphs"

msgid "Minimum zoom level"
msgstr "Niveau de zoom minimum"

msgid "Minimum zoom level for the layer."
msgstr "Niveau de zoom minimum pour la couche."

msgid "Maximum zoom level"
msgstr "Niveau de zoom maximum"

msgid "Maximum zoom level for the layer."
msgstr "Niveau de zoom maximum pour la couche."

msgid "Tile size"
msgstr "Taille de tuile"

msgid "Tile size. Often 256 for raster tiles, 512 for vector tiles."
msgstr "Taille des tuiles. Souvent 256 pour les tuiles raster, 512 pour les tuiles vectorielles."

msgid "Attribution text for the layer."
msgstr "Attribution de la couche."

msgid "Attribution"
msgstr "Attribution"

msgid "Enabled"
msgstr "Activé"

msgid "Whether this layer is enabled and should be displayed on the map."
msgstr "Définit si cette couche est activée et doit être affichée sur la carte."

msgid "Layer"
msgstr "Couche"

msgid "All layers"
msgstr "Fonds de plan des cartes"

msgid "Base layer"
msgstr "Fond de plan de cartes"

msgid "Base layers"
msgstr "Fonds de plan des cartes"

msgid "Overlay layer"
msgstr "Sur-couche de cartes"

msgid "Overlay layers"
msgstr "Sur-couches des cartes"

msgid "Base layer (Raster)"
msgstr "Fond de plan (Raster)"

msgid "Base layers (Raster)"
msgstr "Fonds de plan (Raster)"

msgid "Base layer (Style URL)"
msgstr "Fond de plan (URL de style)"

msgid "Base layers (Style URL)"
msgstr "Fonds de plan (URL de style)"

msgid "Overlay (Raster)"
msgstr "Sur-couche (Raster)"

msgid "Overlays (Raster)"
msgstr "Sur-couches (Raster)"

msgid "Overlay (Style URL)"
msgstr "Sur-couche (URL de style)"

msgid "Overlays (Style URL)"
msgstr "Sur-couches (URL de style)"

msgid "PMTiles file"
msgstr "Fichier PMtiles"

msgid "PMTiles style"
msgstr "Style du PMtiles"

msgid "Notes"
msgstr "Notes"

#, python-format
msgid "Tile URL must contain required tokens: %(tokens)s"
msgstr "L'URL de la tuile doit contenir les jetons requis : %(tokens)s"

#, python-brace-format
msgid "Tile URL cannot contain the '{a}' token, which is not supported for Style URLs. Please add 3 URLs (a, b and c) instead of only once with '{a}'."
msgstr "L'URL de la tuile ne peut pas contenir le jeton '{a}', qui n'est pas pris en charge pour les URL de style. Veuillez ajouter 3 URL (a, b et c) au lieu d'une seule avec '{a}'."

#, python-format
msgid "Tile URL contains unsupported tokens: %(bad_tokens)s. Only %(allowed_tokens)s are allowed for Style URLs."
msgstr "L'URL de la tuile contient des jetons non pris en charge : %(bad_tokens)s. Seuls %(allowed_tokens)s sont autorisés pour les URL de style."
